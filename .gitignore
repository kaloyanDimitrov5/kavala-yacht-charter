# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# original photos and videos from the owner (large; kept locally only).
# scripts/prepare-media.sh builds the web sized files in public/media/ from these,
# and those web sized files ARE committed.
/public/media/images/
/public/media/videos/
/public/media/IMG_*
